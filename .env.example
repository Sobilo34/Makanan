# ==============================================================================
# Makanan Frontend Production Environment Variables
# ==============================================================================

# Public URL of the FastAPI Backend
# NOTE: Next.js inlines NEXT_PUBLIC_* variables during `npm run build`.
# In production, set this to your public API domain with HTTPS:
# e.g., https://api.makanan.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional Analytics & Tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=
